          {
            "text": "Cover your ears and dig",
            "effect": {
              "pool": {
                "stone": 20
              }
            },
            "next": 2
          },
          {
            "text": "Walk away from it",
            "next": "end"
          }
        ]
      },
      {
        "text": "The note resolves into a name. You have never heard it, and you know it is yours.",
        "choices": [
          {
