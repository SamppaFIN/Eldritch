            "effect": {
              "pool": {
                "gold": 25
              },
              "xp": 15
            },
            "next": "end"
          },
          {
            "text": "Bury it deeper",
            "effect": {
              "pool": {
                "wisdom": 15
              },
              "xp": 10
            },
            "next": "end"
          }
        ]
      }
    ]
  },
