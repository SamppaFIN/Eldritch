# Playwright's own build (`vite build --mode e2e`): the shared-world Worker points at a
# port nothing listens on, so no test can ever write to — or read — the live Worker.
# A spec that needs the Worker stubs it with page.route('**/season', ...), which matches
# any host. localhost, so map.spec's foreign-host check stays quiet.
VITE_WORLD_API=http://localhost:9
