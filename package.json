{
  "name": "eldritch-sanctuary-v3",
  "version": "0.5.25",
  "private": true,
  "type": "module",
  "description": "GPS territory-capture game. Walk a closed loop, claim the land inside it.",
  "author": "Infinite",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @es3/game dev",
    "build": "pnpm --filter @es3/game build",
    "preview": "pnpm --filter @es3/game preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --force",
    "e2e": "pnpm --filter @es3/game e2e",
    "lint:lines": "node scripts/check-line-limit.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "typescript": "^5.7.3",
    "vitest": "^3.1.1"
  }
}
